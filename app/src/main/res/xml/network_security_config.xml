<?xml version="1.0" encoding="utf-8"?>
<!--
    Permits cleartext (plain HTTP/WebSocket) traffic to the go-librespot daemon's own local API
    server (127.0.0.1:24879, see GoLibrespotPaths). The daemon has no TLS support and never will,
    since the connection never leaves the device. Scoped to loopback only; all other traffic
    still follows the platform default (cleartext blocked).
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>

+// outboundIPv4 returns the local IPv4 address the kernel would use to reach the public
+// internet, via the standard "UDP connect" trick: connecting a UDP socket never actually
+// sends a packet (UDP is connectionless), it just asks the kernel to pick a route and bind a
+// local address for that destination, which we then read back. This is ordinary,
+// unprivileged INET socket use -- no netlink involved -- and needs no real connectivity to
+// the destination address to work. Kept as a fallback for callers that don't already have an
+// address (e.g. from AndroidInterface.IP).
+func outboundIPv4() (string, error) {
+	conn, err := net.Dial("udp4", "8.8.8.8:80")
+	if err != nil {
+		return "", err
+	}
+	defer func() { _ = conn.Close() }()
+
+	addr, ok := conn.LocalAddr().(*net.UDPAddr)
+	if !ok {
+		return "", &androidZeroconfError{"could not determine local UDP address"}
+	}
+	return addr.IP.String(), nil
+}
+
+type androidZeroconfError struct{ msg string }
+
+func (e *androidZeroconfError) Error() string { return e.msg }

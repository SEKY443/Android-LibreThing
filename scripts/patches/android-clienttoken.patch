+	"strings"
 
 	spotifypb "github.com/devgianlu/go-librespot/proto/spotify"
 	clienttokenpb "github.com/devgianlu/go-librespot/proto/spotify/clienttoken/data/v0"
@@ -112,7 +115,7 @@ func GetPlatformSpecificData() *clienttokenpb.PlatformSpecificData {
 	case "android":
 		return &clienttokenpb.PlatformSpecificData{
 			Data: &clienttokenpb.PlatformSpecificData_Android{
-				Android: &clienttokenpb.NativeAndroidData{},
+				Android: androidNativeData(),
 			},
 		}
 	case "darwin":
@@ -143,3 +146,36 @@ func GetPlatformSpecificData() *clienttokenpb.PlatformSpecificData {
 
 	return nil
 }
+
+// androidNativeData builds the NativeAndroidData Spotify's clienttoken endpoint expects when
+// GetPlatformSpecificData reports GOOS_ANDROID. Sending an all-zero struct here (this fork's
+// prior behaviour, since it's normally cross-compiled for GOOS=linux inside Termux and this
+// path had never actually been exercised against Spotify's servers) gets the client token
+// request rejected with a 400: the fingerprint needs to look like a real device. getprop
+// reads standard build properties that are readable by any Android app, not just system code.
+func androidNativeData() *clienttokenpb.NativeAndroidData {
+	sdkVersion, _ := strconv.Atoi(getprop("ro.build.version.sdk"))
+	model := getprop("ro.product.model")
+
+	return &clienttokenpb.NativeAndroidData{
+		ScreenDimensions: &clienttokenpb.Screen{
+			Width:   1080,
+			Height:  2400,
+			Density: 420,
+		},
+		AndroidVersion: getprop("ro.build.version.release"),
+		ApiVersion:     int32(sdkVersion),
+		DeviceName:     model,
+		ModelStr:       model,
+		Vendor:         getprop("ro.product.manufacturer"),
+		Vendor_2:       getprop("ro.product.brand"),
+	}
+}
+
+func getprop(name string) string {
+	out, err := exec.Command("getprop", name).Output()
+	if err != nil {
+		return ""
+	}
+	return strings.TrimSpace(string(out))
+}
